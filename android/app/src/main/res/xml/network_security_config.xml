<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS: Disallow cleartext HTTP traffic across all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific policy for HR Connect Pro production & staging endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">hrconnectpro.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
